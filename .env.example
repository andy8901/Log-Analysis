# Copy this file to .env and fill in real values -- .env is gitignored,
# this example file is not. See README.md's "Environment variables"
# section for what each of these does.

SECRET_KEY=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-real-password

# Drive sync is optional -- leave both of these unset to disable it.
# On a Windows/Mac office PC, use DRIVE_SYNC_ROOT (a folder synced by
# Google Drive for Desktop). On a Linux server (e.g. via docker-compose),
# Google Drive for Desktop doesn't exist -- use DRIVE_SYNC_RCLONE_REMOTE
# instead, after running `rclone config` once. If both are set,
# DRIVE_SYNC_RCLONE_REMOTE wins.
# DRIVE_SYNC_ROOT=G:\My Drive\LogAnalysis
# DRIVE_SYNC_RCLONE_REMOTE=gdrive:LogAnalysis

# DATABASE_URL / ARCHIVE_ROOT / UPLOAD_TMP: leave unset when running via
# docker-compose.yml -- it sets these itself to point inside the mounted
# data volume. Only set these yourself for a non-Docker deployment.

# Time zone used for clock times in the flight investigation and incident report
REPORT_TZ=Asia/Kolkata
